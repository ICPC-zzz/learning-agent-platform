NODE_ENV="production"
APP_BASE_URL="https://cfagent.fun"

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE"

# Web Auth email OTP provider
# Keep real secrets in local/deployment env only; never commit actual keys.
LAP_EMAIL_AUTH_ENABLED="true"
RESEND_API_KEY="re_your_key"
RESEND_FROM_EMAIL="CF Agent <no-reply@auth.cfagent.fun>"
# Backward-compatible aliases also supported by the Web auth sender:
LAP_EMAIL_API_KEY=""
LAP_EMAIL_FROM=""
EMAIL_FROM=""

# Admin bootstrap. Only promotes existing users; does not create accounts.
LAP_ADMIN_EMAILS="admin@example.com"

# Internal scheduler/admin operations. Use a long random value in production.
LAP_INTERNAL_SCHEDULER_SECRET="replace_with_random_secret"

# Codeforces external API guard.
LAP_CODEFORCES_EXTERNAL_API_ENABLED="false"

# AI Provider Runtime Config MVP
# Default mode is mock and does not call a real model or external network.
# A29 only allows OpenAI-compatible Chapter Q&A when all opt-in values are set.
# Supported modes: mock, openai, anthropic, local, real.
AI_PROVIDER_MODE="mock"
AI_PROVIDER_NETWORK_ENABLED="false"
# Safe fallback is enabled by default: real provider failures return explicit fallback_mock answers.
AI_PROVIDER_FALLBACK_TO_MOCK="true"
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_BASE_URL=""
OPENAI_TIMEOUT_MS=""
ANTHROPIC_API_KEY=""

# Web AI formal model provider. Production calls are fail-closed and require
# both production opt-ins plus a complete provider configuration.
LAP_ALLOW_PRODUCTION_WEB_AI="false"
LAP_ALLOW_REAL_LLM="false"
LAP_ASSISTANT_ENABLED="false"
LAP_ASSISTANT_EXTERNAL_TOOLS_ENABLED="false"
LAP_LLM_ENABLED="false"
LAP_LLM_PROVIDER="openai-compatible"
LAP_LLM_BASE_URL=""
LAP_LLM_API_KEY=""
LAP_LLM_API_PASSWORD=""
LAP_LLM_MODEL=""
LAP_LLM_TIMEOUT_MS="30000"
LAP_LLM_MAX_OUTPUT_TOKENS="2048"

# Content sync. Configure only on the server that runs the scheduler.
LAP_CONTENT_SYNC_ENABLED="true"

# A393: Reader AI QA dev-only external provider config
# All default to disabled/empty — mock is the safe default.
LAP_READER_AI_QA_DEV_ENABLED="false"
LAP_LLM_DEV_PROVIDER_ENABLED="false"
LAP_LLM_DEV_ENDPOINT=""
LAP_LLM_DEV_API_KEY=""
LAP_LLM_DEV_MODEL=""
LAP_LLM_DEV_TIMEOUT_MS=""
