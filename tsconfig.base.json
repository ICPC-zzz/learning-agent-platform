{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@learning-agent-platform/ai-core": ["packages/ai-core/src/index.ts"],
      "@learning-agent-platform/book-engine": ["packages/book-engine/src/index.ts"],
      "@learning-agent-platform/db": ["packages/db/src/index.ts"],
      "@learning-agent-platform/learning-engine": ["packages/learning-engine/src/index.ts"],
      "@learning-agent-platform/shared": ["packages/shared/src/index.ts"]
    }
  }
}
