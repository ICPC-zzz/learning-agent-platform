{
  "name": "@learning-agent-platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./repositories/model-provider-repository": {
      "types": "./dist/repositories/model-provider-repository.d.ts",
      "import": "./dist/repositories/model-provider-repository.js",
      "default": "./dist/repositories/model-provider-repository.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json --outDir dist --declaration --declarationMap false --noEmit false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "prisma db seed --schema prisma/schema.prisma",
    "seed:demo-user": "tsx scripts/seed-demo-user.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.6"
  }
}
