generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookSourceType {
  BUILTIN
  IMPORTED_TEXT
  IMPORTED_MARKDOWN
  IMPORTED_URL
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
  CHALLENGE
}

enum RecommendationStatus {
  PENDING
  COMPLETED
  SKIPPED
  DISMISSED
}

enum ProblemAttemptStatus {
  ATTEMPTED
  SOLVED
  FAILED
  SKIPPED
}

enum ProblemAttemptCorrectness {
  UNKNOWN
  CORRECT
  INCORRECT
  PARTIAL
}

enum AgentSessionContextType {
  BOOK_READING
  GENERAL_AGENT
  SKILL_CREATION
  PROBLEM_PRACTICE
}

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  PROFILE
  SESSION_SUMMARY
  RETRIEVABLE
}

enum SkillRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SkillStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum AutonomyLevel {
  ANSWER_ONLY
  CONFIRM_ALL
  AUTO_READ_LOW
  AUTO_WRITE_LOW
  HIGH_AUTONOMY
}

enum ToolRiskLevel {
  READ_LOW
  WRITE_LOW
  NETWORK
  CREDENTIAL
  DESTRUCTIVE
  EXTERNAL_PUBLISH
  BACKGROUND_LONG_RUNNING
}

enum ChapterQaAnswerSource {
  MOCK
  REAL_OPENAI
  FALLBACK_MOCK
}

enum ChapterQaFeedbackRating {
  HELPFUL
  UNHELPFUL
  NEUTRAL
}

model User {
  id             String  @id @default(cuid())
  authProvider   String?
  authProviderId String?
  email          String? @unique
  name           String?
  avatarUrl      String?

  books                Book[]
  readingProgresses    ReadingProgress[]
  abilityProfile       UserAbilityProfile?
  dailyRecommendations DailyRecommendation[]
  problemAttempts      ProblemAttempt[]
  agentSessions        AgentSession[]
  agentTasks           AgentTask[]
  memoryItems          MemoryItem[]
  skills               Skill[]
  autonomySetting      AutonomySetting?
  chapterQaHistories   ChapterQaHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authProvider, authProviderId])
  @@index([authProvider, authProviderId])
}

model Book {
  id          String         @id @default(cuid())
  ownerId     String?
  sourceType  BookSourceType
  title       String
  subtitle    String?
  author      String?
  description String?
  sourceUrl   String?
  language    String?
  tags        String[]       @default([])
  metadata    Json?

  owner              User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  chapters           BookChapter[]
  chunks             ContentChunk[]
  readingProgresses  ReadingProgress[]
  agentSessions      AgentSession[]
  chapterQaHistories ChapterQaHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([sourceType])
  @@index([title])
}

model BookChapter {
  id         String  @id @default(cuid())
  bookId     String
  parentId   String?
  title      String
  summary    String?
  level      Int     @default(1)
  orderIndex Int

  book               Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent             BookChapter?       @relation("BookChapterTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           BookChapter[]      @relation("BookChapterTree")
  chunks             ContentChunk[]
  readingProgresses  ReadingProgress[]
  agentSessions      AgentSession[]
  chapterQaHistories ChapterQaHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId, orderIndex])
  @@index([parentId])
}

model ContentChunk {
  id          String @id @default(cuid())
  bookId      String
  chapterId   String
  plainText   String
  tokenCount  Int?
  orderIndex  Int
  startOffset Int?
  endOffset   Int?
  metadata    Json?

  book                     Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter                  BookChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lastReadingProgressItems ReadingProgress[] @relation("LastReadingChunk")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, orderIndex])
  @@index([bookId])
  @@index([chapterId])
}

model ReadingProgress {
  id            String    @id @default(cuid())
  userId        String
  bookId        String
  chapterId     String
  lastChunkId   String?
  progressRatio Float     @default(0)
  completedAt   DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter   BookChapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lastChunk ContentChunk? @relation("LastReadingChunk", fields: [lastChunkId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, chapterId])
  @@index([userId, updatedAt])
  @@index([bookId])
  @@index([chapterId])
}

model ChapterQaHistory {
  id                    String                   @id @default(cuid())
  userId                String
  bookId                String
  chapterId             String
  question              String
  answer                String
  answerSource          ChapterQaAnswerSource
  providerId            String
  providerLabel         String
  requestedProviderMode String
  resolvedProviderMode  String
  modelConfigured       Boolean
  networkUsed           Boolean
  fallbackUsed          Boolean
  fallbackReason        String?
  errorCategory         String?
  contextSummary        Json?
  contextChunkRange     Json?
  feedbackRating        ChapterQaFeedbackRating?
  feedbackNote          String?                  @db.VarChar(1000)
  feedbackAt            DateTime?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([bookId])
  @@index([chapterId])
}

model UserAbilityProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  overallScore              Float     @default(0)
  languageFundamentalsScore Float     @default(0)
  algorithmScore            Float     @default(0)
  debuggingScore            Float     @default(0)
  engineeringPracticeScore  Float     @default(0)
  systemDesignScore         Float     @default(0)
  lastEvaluatedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Problem {
  id          String            @id @default(cuid())
  title       String
  description String?
  difficulty  ProblemDifficulty
  tags        String[]          @default([])
  source      String?
  sourceUrl   String?
  metadata    Json?

  dailyRecommendations DailyRecommendation[]
  problemAttempts      ProblemAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([difficulty])
  @@index([source])
}

model ProblemAttempt {
  id                String                    @id @default(cuid())
  userId            String
  problemId         String?
  externalProblemId String?
  source            String                    @default("manual")
  status            ProblemAttemptStatus      @default(ATTEMPTED)
  correctness       ProblemAttemptCorrectness @default(UNKNOWN)
  difficulty        ProblemDifficulty?
  topicTags         String[]                  @default([])
  timeSpentSeconds  Int?
  attemptedAt       DateTime                  @default(now())
  metadata          Json?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, attemptedAt])
  @@index([problemId])
  @@index([externalProblemId])
  @@index([source])
  @@index([status])
}

model DailyRecommendation {
  id                 String               @id @default(cuid())
  userId             String
  problemId          String
  recommendationDate DateTime
  reason             String?
  status             RecommendationStatus @default(PENDING)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId, recommendationDate])
  @@index([userId, recommendationDate])
  @@index([problemId])
  @@index([status])
}

model AgentSession {
  id          String                  @id @default(cuid())
  userId      String
  bookId      String?
  chapterId   String?
  contextType AgentSessionContextType
  title       String?
  metadata    Json?
  endedAt     DateTime?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  chapter     BookChapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  messages    AgentMessage[]
  memoryItems MemoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([contextType])
  @@index([bookId])
  @@index([chapterId])
}

model AgentMessage {
  id         String           @id @default(cuid())
  sessionId  String
  role       AgentMessageRole
  content    String
  orderIndex Int
  metadata   Json?

  session           AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceMemoryItems MemoryItem[] @relation("MemorySourceMessage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, orderIndex])
  @@index([sessionId, createdAt])
  @@index([role])
}

model AgentTask {
  id                   String  @id @default(cuid())
  userId               String?
  taskText             String
  taskSummary          String?
  source               String  @default("user")
  mode                 String  @default("preview_only")
  lifecycleStatus      String  @default("preview_created")
  autonomyLevel        String?
  overallRiskLevel     String?
  readinessStatus      String?
  executable           Boolean @default(false)
  realExecutionEnabled Boolean @default(false)
  safetyFlags          Json?
  previewPayload       Json?
  metadata             Json?

  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  snapshots         AgentTaskSnapshot[]
  events            AgentTaskEvent[]
  runtimeExecutions AgentRuntimeExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([lifecycleStatus])
  @@index([readinessStatus])
  @@index([createdAt])
}

model AgentTaskSnapshot {
  id                   String  @id @default(cuid())
  taskId               String
  snapshotKind         String
  lifecycleStatus      String?
  taskSummary          String?
  executable           Boolean @default(false)
  realExecutionEnabled Boolean @default(false)
  payload              Json?
  safetyNotes          Json?
  metadata             Json?

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([snapshotKind])
  @@index([createdAt])
}

model AgentTaskEvent {
  id                 String @id @default(cuid())
  taskId             String
  eventType          String
  source             String
  severity           String
  message            String
  relatedStepIds     Json?
  relatedStepIndexes Json?
  relatedToolNames   Json?
  relatedSkillNames  Json?
  safetyNotes        Json?
  metadata           Json?

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
}

model AgentPermissionRequest {
  id                       String   @id @default(cuid())
  taskId                   String?
  requestStatus            String   @default("preview_only")
  sourceRequestStatus      String?
  autonomyLevel            String?
  overallRiskLevel         String?
  allowedByCurrentAutonomy Boolean?
  requiresConfirmation     Boolean  @default(false)
  permissionFlowEnabled    Boolean  @default(false)
  executable               Boolean  @default(false)
  realExecutionEnabled     Boolean  @default(false)
  permissionRequests       Json?
  blockedRequests          Json?
  informationalRequests    Json?
  confirmationSummary      Json?
  riskSummary              Json?
  recommendedNextActions   Json?
  safetyNotes              Json?
  previewPayload           Json?
  metadata                 Json?

  decisions AgentPermissionDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([requestStatus])
  @@index([overallRiskLevel])
  @@index([requiresConfirmation])
  @@index([createdAt])
}

model AgentPermissionDecision {
  id                      String  @id @default(cuid())
  permissionRequestId     String?
  taskId                  String?
  decisionStatus          String  @default("no_decision_captured")
  sourceRequestStatus     String?
  permissionFlowEnabled   Boolean @default(false)
  decisionCaptured        Boolean @default(false)
  executable              Boolean @default(false)
  realExecutionEnabled    Boolean @default(false)
  requiredBeforeExecution Boolean @default(false)
  approvableRequestIds    Json?
  blockedRequestIds       Json?
  informationalRequestIds Json?
  missingDecisionReasons  Json?
  blockedReasons          Json?
  decisionItems           Json?
  decisionShapePreview    Json?
  recommendedNextActions  Json?
  safetyNotes             Json?
  previewPayload          Json?
  metadata                Json?

  permissionRequest AgentPermissionRequest? @relation(fields: [permissionRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([permissionRequestId])
  @@index([taskId])
  @@index([decisionStatus])
  @@index([decisionCaptured])
  @@index([requiredBeforeExecution])
  @@index([createdAt])
}

model AgentRuntimeExecution {
  id                            String  @id @default(cuid())
  taskId                        String?
  userId                        String?
  executionStatus               String  @default("preview_ready")
  lifecycleStatus               String  @default("preview_only")
  boundaryFlags                 Json?
  safetyFlags                   Json?
  transitionState               Json?
  currentStepId                 String?
  executable                    Boolean @default(false)
  realExecutionEnabled          Boolean @default(false)
  toolExecutionEnabled          Boolean @default(false)
  llmCallEnabled                Boolean @default(false)
  permissionConfirmationEnabled Boolean @default(false)
  backgroundJobEnabled          Boolean @default(false)
  streamingEnabled              Boolean @default(false)
  previewOnly                   Boolean @default(true)
  metadata                      Json?
  errors                        Json?

  task      AgentTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  steps     AgentRuntimeStep[]
  toolCalls AgentRuntimeToolCall[]
  llmCalls  AgentRuntimeLlmCall[]
  events    AgentRuntimeEvent[]
  auditLogs AgentRuntimeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([executionStatus])
  @@index([createdAt])
}

model AgentRuntimeStep {
  id                   String  @id @default(cuid())
  executionId          String
  stepKey              String?
  title                String
  kind                 String
  status               String  @default("preview_only")
  riskLevel            String?
  summary              String?
  inputSummary         String?
  outputSummary        String?
  blockedReasons       Json?
  metadata             Json?
  previewOnly          Boolean @default(true)
  executable           Boolean @default(false)
  realExecutionEnabled Boolean @default(false)

  execution AgentRuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([executionId])
  @@index([status])
}

model AgentRuntimeToolCall {
  id                   String  @id @default(cuid())
  executionId          String
  stepId               String?
  toolName             String
  toolKind             String?
  status               String  @default("preview_only")
  requirementSummary   String?
  inputSummary         String?
  resultSummary        String?
  riskLevel            String?
  blockedReasons       Json?
  sandboxRequired      Boolean @default(true)
  previewOnly          Boolean @default(true)
  executable           Boolean @default(false)
  realExecutionEnabled Boolean @default(false)
  toolExecutionEnabled Boolean @default(false)
  metadata             Json?

  execution AgentRuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([executionId])
  @@index([toolName])
  @@index([status])
}

model AgentRuntimeLlmCall {
  id                    String  @id @default(cuid())
  executionId           String
  stepId                String?
  providerKind          String?
  modelLabel            String?
  requestSummary        String?
  responseSummary       String?
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?
  status                String  @default("preview_only")
  blockedReasons        Json?
  previewOnly           Boolean @default(true)
  executable            Boolean @default(false)
  realExecutionEnabled  Boolean @default(false)
  llmCallEnabled        Boolean @default(false)
  streamingEnabled      Boolean @default(false)
  metadata              Json?

  execution AgentRuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([executionId])
  @@index([providerKind])
  @@index([status])
}

model AgentRuntimeEvent {
  id                   String  @id @default(cuid())
  executionId          String
  eventKind            String
  fromStatus           String?
  toStatus             String?
  action               String?
  message              String?
  payload              Json?
  previewOnly          Boolean @default(true)
  executable           Boolean @default(false)
  realExecutionEnabled Boolean @default(false)

  execution AgentRuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([eventKind])
  @@index([createdAt])
}

model AgentRuntimeAuditLog {
  id                     String  @id @default(cuid())
  executionId            String
  actorKind              String?
  action                 String
  targetKind             String?
  riskLevel              String?
  riskSummary            String?
  boundaryFlags          Json?
  safetyFlags            Json?
  metadata               Json?
  previewOnly            Boolean @default(true)
  executable             Boolean @default(false)
  realExecutionEnabled   Boolean @default(false)
  productionAuditEnabled Boolean @default(false)

  execution AgentRuntimeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([action])
  @@index([createdAt])
}

model MemoryItem {
  id              String     @id @default(cuid())
  userId          String
  sessionId       String?
  sourceMessageId String?
  memoryType      MemoryType
  content         String
  importance      Float      @default(0)
  metadata        Json?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sourceMessage AgentMessage? @relation("MemorySourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, memoryType])
  @@index([sessionId])
  @@index([importance])
}

model Skill {
  id                    String         @id @default(cuid())
  ownerUserId           String?
  name                  String
  description           String?
  version               String         @default("0.1.0")
  riskLevel             SkillRiskLevel @default(LOW)
  requiredAutonomyLevel AutonomyLevel  @default(CONFIRM_ALL)
  status                SkillStatus    @default(DRAFT)
  manifest              Json?
  metadata              Json?

  owner            User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  toolRequirements SkillToolRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, name, version])
  @@index([ownerUserId])
  @@index([status])
  @@index([riskLevel])
}

model SkillToolRequirement {
  id               String  @id @default(cuid())
  skillId          String
  toolDefinitionId String?
  toolName         String
  riskNote         String?
  isRequired       Boolean @default(true)

  skill          Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  toolDefinition ToolDefinition? @relation(fields: [toolDefinitionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, toolName])
  @@index([toolName])
  @@index([toolDefinitionId])
}

model ToolDefinition {
  id                   String        @id @default(cuid())
  name                 String        @unique
  description          String?
  riskLevel            ToolRiskLevel
  requiresConfirmation Boolean       @default(false)
  metadata             Json?

  skillRequirements SkillToolRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskLevel])
}

model AutonomySetting {
  id                           String        @id @default(cuid())
  userId                       String        @unique
  level                        AutonomyLevel @default(ANSWER_ONLY)
  allowToolUse                 Boolean       @default(false)
  requireConfirmationAboveRisk ToolRiskLevel @default(WRITE_LOW)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Dev-only book favorites for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Owner isolation is enforced via @@unique([userId, bookId]).
model BookFavorite {
  id             String   @id @default(cuid())
  userId         String
  bookId         String
  bookTitle      String
  sourceType     String
  firstChapterId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, createdAt])
  @@index([bookId])
}

/// Dev-only problem favorites for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Uses a composite key on (userId, problemId) for idempotent upsert.
model ProblemFavorite {
  id            String   @id @default(cuid())
  userId        String
  problemId     String
  problemTitle  String
  difficulty    String
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([userId, createdAt])
  @@index([problemId])
  @@index([difficulty])
}

/// Dev-only problem practice activity for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Stores practice status transitions with timestamps.
model ProblemPracticeActivity {
  id           String   @id @default(cuid())
  userId       String
  problemId    String
  problemTitle String
  difficulty   String
  status       String   @default("practiced")
  tags         String[] @default([])
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([userId, updatedAt])
  @@index([problemId])
  @@index([status])
}

/// Dev-only reader bookmarks for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// A bookmark is unique per (userId, bookId, chapterId).
model ReaderBookmark {
  id            String   @id @default(cuid())
  userId        String
  bookId        String
  chapterId     String
  bookTitle     String
  chapterTitle  String
  progressRatio Float    @default(0)
  sourceType    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, bookId, chapterId])
  @@index([userId, createdAt])
  @@index([bookId])
  @@index([chapterId])
}

/// Dev-only reader notes for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Multiple notes per chapter are allowed (no @@unique constraint on chapter).
model ReaderNote {
  id             String   @id @default(cuid())
  userId         String
  bookId         String
  chapterId      String
  bookTitle      String
  chapterTitle   String
  progressRatio  Float    @default(0)
  noteText       String
  excerptPreview String?
  sourceType     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([bookId])
  @@index([chapterId])
}

/// Dev-only unified learning activity timeline for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Records user actions: read-book, practice-problem, favorite-book,
/// favorite-problem, add-note, add-bookmark, import-book.
model LearningActivity {
  id               String   @id @default(cuid())
  userId           String
  activityType     String
  title            String
  targetType       String
  targetId         String
  bookId           String?
  chapterId        String?
  problemId        String?
  sourceType       String
  occurredAt       DateTime
  durationSeconds  Int?
  metadataPreview  String?
  createdAt        DateTime @default(now())

  @@index([userId, occurredAt(sort: Desc)])
  @@index([activityType])
  @@index([targetType])
}

/// Dev-only reading session timer for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Tracks timed reading sessions with start/end and duration.
model ReadingSession {
  id             String    @id @default(cuid())
  userId         String
  bookId         String
  chapterId      String
  bookTitle      String
  chapterTitle   String
  startedAt      DateTime
  endedAt        DateTime?
  durationSeconds Int
  progressRatio  Float     @default(0)
  sourceType     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, startedAt(sort: Desc)])
  @@index([bookId])
  @@index([chapterId])
}

/// Dev-only problem wrong book for DB persistence.
/// userId is NOT a FK to User — dev session users may not have real User records.
/// Uses composite unique key on (ownerId, problemId) for idempotent upsert.
model ProblemWrongBook {
  id           String   @id @default(cuid())
  ownerId      String
  problemId    String
  problemTitle String
  difficulty   String
  tagsJson     String   @default("[]")
  wrongCount   Int      @default(1)
  lastWrongAt  DateTime @default(now())
  reviewStatus String   @default("needs-review")
  notePreview  String?
  sourceType   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, problemId])
  @@index([ownerId, lastWrongAt(sort: Desc)])
  @@index([problemId])
  @@index([reviewStatus])
}
