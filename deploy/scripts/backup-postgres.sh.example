#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="${BACKUP_DIR:-/var/backups/learning-agent-platform/postgres}"
RETENTION_DAYS="${RETENTION_DAYS:-14}"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUTPUT="${BACKUP_DIR}/learning-agent-platform-${TIMESTAMP}.dump"

mkdir -p "${BACKUP_DIR}"
chmod 700 "${BACKUP_DIR}"

if [[ -z "${DATABASE_URL:-}" ]]; then
  echo "DATABASE_URL is required in the protected environment." >&2
  exit 1
fi

pg_dump "${DATABASE_URL}" --format=custom --no-owner --no-acl --file="${OUTPUT}"
chmod 600 "${OUTPUT}"

find "${BACKUP_DIR}" -type f -name 'learning-agent-platform-*.dump' -mtime +"${RETENTION_DAYS}" -delete

echo "backup_created=${OUTPUT}"
