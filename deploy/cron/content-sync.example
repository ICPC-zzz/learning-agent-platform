# Legacy content scheduler template.
#
# Production content synchronization is managed by:
#   learning-agent-platform-content-sync.timer
#   learning-agent-platform-content-sync.service
#
# Install the systemd templates from deploy/systemd instead of scheduling
# content commands here. Keeping both schedulers active would create duplicate
# attempts, so this template intentionally contains no active content jobs.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
